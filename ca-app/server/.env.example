# ---- Super Admin (required) ----
# The super admin account is defined here, NOT via the UI.
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=change-this-strong-password
SUPER_ADMIN_NAME=Super Admin

# ---- Security ----
# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=please-change-this-to-a-long-random-string

# ---- App URL (used to build invite links) ----
# Dev (Vite):  http://localhost:5173
# Production (single port): http://localhost:4000
APP_URL=http://localhost:5173

# ---- Server port ----
PORT=4000

# ---- Email / SMTP (OPTIONAL) ----
# If these are set, invite emails are actually sent.
# If left blank, the app runs in "dev mode": the invite link is shown in the UI
# to copy & send manually, and printed to the server console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=QA Corrective Action <you@gmail.com>
